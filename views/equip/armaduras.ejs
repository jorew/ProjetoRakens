<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/styleRL.css">
    <title>Armaduras</title>
</head>
<body>

<br>
  <h1 style="color: white; text-align: center;">Os Rakens Lendários</h1>
<pre></pre>

<main>
  <h3 class="n3-align">Armaduras Raken</h3>

  <%- include('../partials/header') %>
  <br>
  <h3 class="n3-align">Lista de Armaduras</h3>
  <br>

<ol>
  <% armaduras.forEach(function(item) { %>
    <li>
      <!-- Aponta diretamente para /detalhe/1encantamento ou /detalhe/2paixao -->
      <a href="/detalhe/<%= item.slug || item.les_ %>">
        <div class="container-flex2">
          
          <img 
            src="/images/SymbolsRL/<%= item.slug || item.les_ %>.png" 
            alt="Símbolo <%= item.nome %>"
            onerror="this.src='/images/SymbolsRL/10esperanca.png';"
          >
          
          <h4 class="a-aar">Raken <%= item.nome %></h4>
        </div>
      </a>
    </li>
    <br>
  <% }); %>
</ol>


  <pre>
  

  
  
  
  </pre>

  <%- include('../partials/footer') %>
</main>

</body>
</html>
