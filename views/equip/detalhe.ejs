<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/styleRL.css">
    <title>Raken <%= item.nome %></title>
</head>
<body>

<main>

  <br>
  <h1 class="tituloprin">Os Rakens Lendários</h1>

  <pre>


  </pre>


  <%- include('../partials/header') %>

  <br>

  <a href="/armaduras" style="color: white;">← Voltar para a Lista</a>
  <pre>


  </pre>

   <h3 class="n3-align"><%= item.nome %></h3>

  <br>
  <div style="max-width: 500px; margin: 0 auto;">
    <a href="/armaduras" class="btn-voltar">← Voltar para a Lista</a>
  </div>
  <br>

  <!-- CARD ESTILO RPG -->
  <article class="rpg-card">
    <header class="rpg-header">
      <h1 class="rpg-title"><%= item.nome %></h1>
      <span class="rpg-subtitle">Armadura Lendária Raken</span>
    </header>

    <div class="rpg-image-container">
      <img class="imagem-apresent"
        src="/images/SymbolsRL/<%= item.slug || item.les_ %>.png" 
        alt="Símbolo <%= item.nome %>"
        class="rpg-symbol"
        onerror="this.src='/images/SymbolsRL/10esperanca.png';"
      >
    </div>

    <div class="rpg-divider"></div>

    <section class="rpg-stats">
      <p><span>Dono:</span> <strong><%= item.dono %></strong></p>
      <p><span>RakanDeã:</span> <strong><%= item.RakanDeã %></strong></p>
      <p><span>RakanMalian:</span> <strong><%= item.RakanMalian %></strong></p>
      <p><span>Conceito:</span> <strong><%= item.conceito %></strong></p>
      <p><span>Dignidade:</span> <strong class="stat-highlight"><%= item.dignidade %></strong></p>
    </section>

    <% if (item.habilidades && item.habilidades.length > 0) { %>
      <div class="rpg-divider"></div>

      <section class="rpg-skills">
        <h3>Habilidades Concedidas:</h3>
        <ul>
          <% item.habilidades.forEach(function(hab) { %>
            <li><%= hab %></li>
          <% }); %>
        </ul>
      </section>
    <% } %>
  </article>

  <pre>










  </pre>

  <br>
  <%- include('../partials/footer') %>
</main>

</body>
</html>
