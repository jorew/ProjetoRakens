<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/styleRL.css">
    <title>Raken <%= item.nome %></title>
</head>
<body>

<main>

  <br>
  <h1 class="tituloprin">Os Rakens Lendários</h1>

  <pre>


  </pre>


  <%- include('../partials/header') %>

  <br>

  <a href="/armaduras" style="color: white;">← Voltar para a Lista</a>
  <pre>


  </pre>

   <h3 class="n3-align"><%= item.nome %></h3>

  <div style="text-align: center;">
    <img class="imagem-apresent"
      src="/images/SymbolsRL/<%= item.slug || item.les_ %>.png" 
      alt="Símbolo <%= item.nome %>"
      width="200"
      onerror="this.src='/images/SymbolsRL/10esperanca.png';"
    >
  </div>

  <section style="color: white; max-width: 600px; margin: 0 auto;">
    <p><strong>Dono:</strong> <%= item.dono %></p>
    <p><strong>RakanDeã:</strong> <%= item.RakanDeã %></p>
    <p><strong>RakanMalian:</strong> <%= item.RakanMalian %></p>
    <p><strong>Conceito:</strong> <%= item.conceito %></p>
    <p><strong>Dignidade:</strong> <%= item.dignidade %></p>

    <!-- Exibindo a lista de Habilidades/Array -->
    <% if (item.habilidades && item.habilidades.length > 0) { %>
      <h3>Habilidades:</h3>
      <ul>
        <% item.habilidades.forEach(function(hab) { %>
          <li><%= hab %></li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <pre>





  </pre>

  <%- include('../partials/footer') %>
</main>

</body>
</html>
